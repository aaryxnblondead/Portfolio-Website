# Spotify feed endpoint (Cloudflare Worker URL)
# Deploy the worker in /worker and set this to the deployed URL
NEXT_PUBLIC_SPOTIFY_FEED_URL=https://

# Spotify client credentials (used only by the worker / refresh-token script)
# Set these as Worker secrets via: npx wrangler secret put SPOTIFY_CLIENT_ID
# SPOTIFY_CLIENT_ID=your-client-id-here
# SPOTIFY_CLIENT_SECRET=your-client-secret-here
